DATABASE_URL=postgres://user:pass@localhost:5432/channel
ANTHROPIC_API_KEY=

# Бот: создать у @BotFather, добавить админом в канал с правом публикации
TELEGRAM_BOT_TOKEN=
# Куда публиковать: @username канала или числовой id (-100…)
TELEGRAM_CHANNEL_ID=
# Ваш личный chat id — только вам бот присылает черновики и только вас слушает.
# Оставьте пустым, напишите боту /start — он ответит вашим id.
TELEGRAM_OWNER_CHAT_ID=

# Как часто собирать ленту и готовить черновики (часы)
PIPELINE_INTERVAL_HOURS=6
# Сколько черновиков максимум за один прогон
DRAFTS_PER_RUN=3
# Порог смысловой оценки 0–5
MIN_SCORE=4
# Часы публикации одобренных постов (по TZ ниже), через запятую
PUBLISH_HOURS=10,19
TZ=Europe/Moscow
